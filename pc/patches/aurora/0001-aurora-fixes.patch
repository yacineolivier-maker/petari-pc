+// Port addition (auto mipmaps): appends a full box-filtered mip chain to an RGBA8 level 0. Colors
+// are averaged weighted by alpha, so the color of fully transparent texels doesn't bleed in.
+// Returns the number of levels.
+uint32_t append_rgba8_mips(ByteBuffer& data, uint32_t width, uint32_t height) {
+  uint32_t levels = 1;
+  for (uint32_t w = width, h = height; w > 1 || h > 1; w = std::max(w >> 1, 1u), h = std::max(h >> 1, 1u)) {
+    ++levels;
+  }
+  size_t total = 0;
+  for (uint32_t i = 0; i < levels; ++i) {
+    total += size_t(std::max(width >> i, 1u)) * std::max(height >> i, 1u) * 4;
+  }
+  ByteBuffer out(total);
+  std::memcpy(out.data(), data.data(), size_t(width) * height * 4);
+  size_t srcOff = 0;
+  size_t dstOff = size_t(width) * height * 4;
+  uint32_t sw = width, sh = height;
+  for (uint32_t i = 1; i < levels; ++i) {
+    const uint32_t dw = std::max(sw >> 1, 1u), dh = std::max(sh >> 1, 1u);
+    const u8* src = out.data() + srcOff;
+    u8* dst = out.data() + dstOff;
+    for (uint32_t y = 0; y < dh; ++y) {
+      for (uint32_t x = 0; x < dw; ++x) {
+        uint32_t c[3] = {}, cw[3] = {}, a = 0, n = 0;
+        for (uint32_t dy = 0; dy < 2; ++dy) {
+          for (uint32_t dx = 0; dx < 2; ++dx) {
+            const uint32_t sx = std::min(x * 2 + dx, sw - 1), sy = std::min(y * 2 + dy, sh - 1);
+            const u8* p = src + (size_t(sy) * sw + sx) * 4;
+            for (int k = 0; k < 3; ++k) {
+              c[k] += p[k];
+              cw[k] += p[k] * p[3];
+            }
+            a += p[3];
+            ++n;
+          }
+        }
+        u8* q = dst + (size_t(y) * dw + x) * 4;
+        for (int k = 0; k < 3; ++k) {
+          q[k] = static_cast<u8>(a != 0 ? (cw[k] + a / 2) / a : (c[k] + n / 2) / n);
+        }
+        q[3] = static_cast<u8>((a + n / 2) / n);
+      }
+    }
+    srcOff = dstOff;
+    dstOff += size_t(dw) * dh * 4;
+    sw = dw;
+    sh = dh;
+  }
+  data = std::move(out);
+  return levels;
+}
