+// Alpha to coverage (port addition): the alpha compare as a signed distance from its threshold,
+// in alpha units (>= 0 passes, like the hard test). constant: 1 = always passes, 0 = never;
+// valid = false when the comparison can't be expressed this way (EQUAL/NEQUAL).
+struct AlphaMarginExpr {
+  std::string expr;
+  int constant = -1;
+  bool valid = true;
+};
+
+AlphaMarginExpr alpha_margin_const(bool pass) { return {"", pass ? 1 : 0, true}; }
+AlphaMarginExpr alpha_margin_invalid() { return {"", -1, false}; }
+
+AlphaMarginExpr alpha_margin(GXCompare comp, u8 ref) {
+  // The hard test compares round(a * 255) with ref: thresholds sit half a step from ref.
+  const float lo = (static_cast<float>(ref) - 0.5f) / 255.0f;
+  const float hi = (static_cast<float>(ref) + 0.5f) / 255.0f;
+  switch (comp) {
+  default:
+    return alpha_margin_invalid();
+  case GX_NEVER:
+    return alpha_margin_const(false);
+  case GX_ALWAYS:
+    return alpha_margin_const(true);
+  case GX_LESS:
+    return ref == 0 ? alpha_margin_const(false) : AlphaMarginExpr{fmt::format("({:.8f} - acA)", lo)};
+  case GX_LEQUAL:
+    return ref == 255 ? alpha_margin_const(true) : AlphaMarginExpr{fmt::format("({:.8f} - acA)", hi)};
+  case GX_GEQUAL:
+    return ref == 0 ? alpha_margin_const(true) : AlphaMarginExpr{fmt::format("(acA - {:.8f})", lo)};
+  case GX_GREATER:
+    return ref == 255 ? alpha_margin_const(false) : AlphaMarginExpr{fmt::format("(acA - {:.8f})", hi)};
+  }
+}
