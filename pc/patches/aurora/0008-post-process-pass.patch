+// BEGIN POST-PROCESS REGION (source = resampled image, same size as the target)
+
+fn luma(c: vec3<f32>) -> f32 {
+    return dot(c, vec3<f32>(0.299, 0.587, 0.114));
+}
+
+fn load_rgb(p: vec2<i32>) -> vec3<f32> {
+    return sample_by_pixel(p).rgb;
+}
+
+fn sample_rgb(uv: vec2<f32>) -> vec3<f32> {
+    return textureSampleLevel(t, s, uv, 0.0).rgb;
+}
+
+// FXAA (Lottes' PC/console variant): alpha = 1 where an edge was smoothed.
+fn fxaa(uv: vec2<f32>, rcp: vec2<f32>, center: vec3<f32>) -> vec4<f32> {
+    let rgb_nw = sample_rgb(uv + vec2<f32>(-0.5, -0.5) * rcp);
+    let rgb_ne = sample_rgb(uv + vec2<f32>(0.5, -0.5) * rcp);
+    let rgb_sw = sample_rgb(uv + vec2<f32>(-0.5, 0.5) * rcp);
+    let rgb_se = sample_rgb(uv + vec2<f32>(0.5, 0.5) * rcp);
+    let l_nw = luma(rgb_nw);
+    let l_ne = luma(rgb_ne);
+    let l_sw = luma(rgb_sw);
+    let l_se = luma(rgb_se);
+    let l_m = luma(center);
+    let l_min = min(l_m, min(min(l_nw, l_ne), min(l_sw, l_se)));
+    let l_max = max(l_m, max(max(l_nw, l_ne), max(l_sw, l_se)));
+    if (l_max - l_min < max(0.0312, l_max * 0.125)) {
+        return vec4<f32>(center, 0.0);
+    }
+    var dir = vec2<f32>(-((l_nw + l_ne) - (l_sw + l_se)), (l_nw + l_sw) - (l_ne + l_se));
+    let dir_reduce = max((l_nw + l_ne + l_sw + l_se) * (0.25 * 0.125), 1.0 / 128.0);
+    let rcp_dir_min = 1.0 / (min(abs(dir.x), abs(dir.y)) + dir_reduce);
+    dir = clamp(dir * rcp_dir_min, vec2<f32>(-8.0, -8.0), vec2<f32>(8.0, 8.0)) * rcp;
+    let rgb_a = 0.5 * (sample_rgb(uv + dir * (1.0 / 3.0 - 0.5)) + sample_rgb(uv + dir * (2.0 / 3.0 - 0.5)));
+    let rgb_b = rgb_a * 0.5 + 0.25 * (sample_rgb(uv - dir * 0.5) + sample_rgb(uv + dir * 0.5));
+    let l_b = luma(rgb_b);
+    if (l_b < l_min || l_b > l_max) {
+        return vec4<f32>(rgb_a, 1.0);
+    }
+    return vec4<f32>(rgb_b, 1.0);
+}
+
+@fragment
+fn fs_post(in: VertexOutput) -> @location(0) vec4<f32> {
+    let p = vec2<i32>(floor(in.position.xy));
+    let dims = vec2<f32>(textureDimensions(t));
+    let e = load_rgb(p);
+    var color = e;
+    var edge = 0.0;
+    if ((uniforms.post_flags & 1u) != 0u) {
+        let r = fxaa(in.position.xy / dims, 1.0 / dims, e);
+        color = r.rgb;
+        edge = r.a;
+    }
+    if (uniforms.sharpen > 0.0) {
+        // AMD FidelityFX CAS (simplified): sharpens less where the local contrast is already high.
+        let a = load_rgb(p + vec2<i32>(-1, -1));
+        let b = load_rgb(p + vec2<i32>(0, -1));
+        let c = load_rgb(p + vec2<i32>(1, -1));
+        let d = load_rgb(p + vec2<i32>(-1, 0));
+        let f = load_rgb(p + vec2<i32>(1, 0));
+        let g = load_rgb(p + vec2<i32>(-1, 1));
+        let h = load_rgb(p + vec2<i32>(0, 1));
+        let i = load_rgb(p + vec2<i32>(1, 1));
+        var mn = min(min(min(d, e), min(f, b)), h);
+        mn = mn + min(mn, min(min(a, c), min(g, i)));
+        var mx = max(max(max(d, e), max(f, b)), h);
+        mx = mx + max(mx, max(max(a, c), max(g, i)));
+        let amp = sqrt(clamp(min(mn, vec3<f32>(2.0) - mx) / max(mx, vec3<f32>(1e-5)), vec3<f32>(0.0), vec3<f32>(1.0)));
+        let peak = -1.0 / mix(8.0, 5.0, clamp(uniforms.sharpen, 0.0, 1.0));
+        let w = amp * peak * (1.0 - edge);
+        color = clamp((color + w * (b + d + f + h)) / (vec3<f32>(1.0) + 4.0 * w), vec3<f32>(0.0), vec3<f32>(1.0));
+    }
+    if (uniforms.vibrance != 0.0) {
+        // Boosts the saturation of dull colors more than that of already saturated ones.
+        let l = luma(color);
+        let sat = max(color.r, max(color.g, color.b)) - min(color.r, min(color.g, color.b));
+        color = clamp(mix(vec3<f32>(l), color, 1.0 + uniforms.vibrance * (1.0 - sat)), vec3<f32>(0.0), vec3<f32>(1.0));
+    }
+    return vec4<f32>(color, 1.0);
+}
