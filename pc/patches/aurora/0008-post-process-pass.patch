+static const TextureWithSampler& post_process(const wgpu::CommandEncoder& encoder, const TextureWithSampler& source) {
+  const bool fxaa = g_postFxaa.load(std::memory_order_relaxed);
+  const float sharpen = g_postSharpen.load(std::memory_order_relaxed);
+  const float vibrance = g_postVibrance.load(std::memory_order_relaxed);
+  if (!g_PostPipeline || (!fxaa && sharpen <= 0.f && vibrance == 0.f)) {
+    return source;
+  }
+  const uint32_t width = source.size.width;
+  const uint32_t height = source.size.height;
+  if (!g_postFrameBuffer.view || g_postFrameBuffer.size.width != width || g_postFrameBuffer.size.height != height ||
+      g_postFrameBuffer.format != source.format) {
+    g_postFrameBuffer = create_render_texture(width, height, false);
+  }
+
+  const ResampleUniformBlock uniform{
+      .samplerMode = 0,
+      .frameWidth = static_cast<float>(width),
+      .frameHeight = static_cast<float>(height),
+      .postFlags = fxaa ? 1u : 0u,
+      .sharpen = sharpen,
+      .vibrance = vibrance,
+  };
+  g_queue.WriteBuffer(g_PostUniformBuffer, 0, &uniform, sizeof(uniform));
+
+  const std::array bindGroupEntries{
+      wgpu::BindGroupEntry{
+          .binding = 0,
+          .buffer = g_PostUniformBuffer,
+          .size = AURORA_ALIGN(sizeof(ResampleUniformBlock), 16),
+      },
+      wgpu::BindGroupEntry{
+          .binding = 1,
+          .sampler = source.sampler,
+      },
+      wgpu::BindGroupEntry{
+          .binding = 2,
+          .textureView = source.view,
+      },
+  };
+  const wgpu::BindGroupDescriptor bindGroupDescriptor{
+      .layout = g_ResampleBindGroupLayout,
+      .entryCount = bindGroupEntries.size(),
+      .entries = bindGroupEntries.data(),
+  };
+  const auto bindGroup = g_device.CreateBindGroup(&bindGroupDescriptor);
+
+  const std::array attachments{
+      wgpu::RenderPassColorAttachment{
+          .view = g_postFrameBuffer.view,
+          .loadOp = wgpu::LoadOp::Clear,
+          .storeOp = wgpu::StoreOp::Store,
+      },
+  };
+  const wgpu::RenderPassDescriptor renderPassDescriptor{
+      .label = "Present post-process render pass",
+      .colorAttachmentCount = attachments.size(),
+      .colorAttachments = attachments.data(),
+      .timestampWrites = gpu_prof::pass_writes("Present post-process"),
+  };
+  const auto pass = encoder.BeginRenderPass(&renderPassDescriptor);
+  pass.SetPipeline(g_PostPipeline);
+  pass.SetBindGroup(0, bindGroup, 0, nullptr);
+  pass.SetViewport(0.f, 0.f, static_cast<float>(width), static_cast<float>(height), 0.f, 1.f);
+  pass.Draw(3);
+  pass.End();
+  return g_postFrameBuffer;
+}
